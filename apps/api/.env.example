DATABASE_URL="postgresql://postgres:password@localhost:5432/agency_crm?schema=public"
PORT=4000
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET="replace-with-a-long-development-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-development-secret"

# Invitation delivery defaults to terminal output in local development.
EMAIL_PROVIDER=console
# For Gmail SMTP: set EMAIL_PROVIDER=smtp, then use smtp.gmail.com, port 587,
# SMTP_SECURE=false, your Gmail address, and a Google App Password.
EMAIL_FROM="Atlas Digital <your-gmail-address@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password
# For production delivery instead, set EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Members deactivated within this window can be restored directly by an admin.
# Use 1 locally to test the reactivation-invitation flow; use 525600 for one year.
MEMBER_REACTIVATION_WINDOW_MINUTES=525600
